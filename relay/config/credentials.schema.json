{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BabyMonkey relay credentials",
  "type": "object",
  "additionalProperties": false,
  "required": ["telegram_bot_token", "telegram_destination", "fixed_message"],
  "properties": {
    "telegram_bot_token": { "type": "string", "minLength": 37, "maxLength": 77 },
    "telegram_destination": { "type": "string", "pattern": "^-?[0-9]{1,20}$" },
    "fixed_message": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}
