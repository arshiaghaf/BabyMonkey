{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "babymonkey-oss-local",
  "main": "worker.ts",
  "alias": {
    "server-only": "./node_modules/server-only/empty.js"
  },
  "compatibility_date": "2026-08-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "BABYMONKEY_RP_ID": "localhost",
    "BABYMONKEY_ORIGIN": "http://localhost:3000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "babymonkey-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "remote": false
    }
  ]
}
