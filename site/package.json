{
  "name": "babymonkey-ui-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 node scripts/run-development-preview.mjs --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "build:cloudflare": "NEXT_TELEMETRY_DISABLED=1 CLOUDFLARE_CF_FETCH_ENABLED=false WRANGLER_SEND_METRICS=false WRANGLER_SEND_ERROR_REPORTS=false opennextjs-cloudflare build && node scripts/stage-protected-assets.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .open-next --ignore-pattern coverage",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "test:relay:local": "vitest run --config vitest.relay.config.ts",
    "test:browser": "npm run test:browser:development",
    "test:browser:development": "playwright test --config playwright.config.ts",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:d1 && npm run test:relay:local && npm run test:setup",
    "demo": "BABYMONKEY_LOCAL_DEMO=1 BABYMONKEY_FAKE_DELIVERY=confirmed NEXT_TELEMETRY_DISABLED=1 node scripts/run-development-preview.mjs --hostname 127.0.0.1",
    "setup:check": "node scripts/setup-check.mjs",
    "test:browser:demo": "node scripts/run-demo-browser-tests.mjs",
    "demo:failure": "BABYMONKEY_LOCAL_DEMO=1 BABYMONKEY_FAKE_DELIVERY=definitive-failure NEXT_TELEMETRY_DISABLED=1 node scripts/run-development-preview.mjs --hostname 127.0.0.1",
    "demo:ambiguous": "BABYMONKEY_LOCAL_DEMO=1 BABYMONKEY_FAKE_DELIVERY=ambiguous NEXT_TELEMETRY_DISABLED=1 node scripts/run-development-preview.mjs --hostname 127.0.0.1",
    "artifact:check": "node scripts/check-artifact.mjs",
    "test:setup": "node --test --test-concurrency=1 scripts/setup-check.test.mjs scripts/demo-safety.test.mjs scripts/runner-lifecycle.test.mjs scripts/browser-output.test.mjs",
    "test:browser:production": "node scripts/run-cloudflare-browser-tests.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.7",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.5",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.146.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.29.1",
      "sharp": "0.35.5"
    },
    "jsdom": {
      "undici": "8.10.2"
    }
  }
}
